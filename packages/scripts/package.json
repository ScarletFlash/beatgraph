{
  "name": "@beatgraph/scripts",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "directory": "packages/scripts",
    "type": "git",
    "url": "git+https://github.com/ScarletFlash/beatgraph.git"
  },
  "type": "module",
  "main": "./src/public-api.ts",
  "types": "./src/public-api.ts",
  "scripts": {
    "bump-version": "tsx --tsconfig ./tsconfig.scripts.json scripts/bump-version.script.ts",
    "check:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "check:src": "tsc --project tsconfig.src.json --noEmit"
  },
  "dependencies": {
    "@pnpm/pkg-manifest.reader": "catalog:codebase",
    "arktype": "catalog:stack",
    "detect-libc": "catalog:stack"
  },
  "devDependencies": {
    "@beatgraph/configs": "workspace:*",
    "@pnpm/types": "catalog:codebase",
    "@pnpm/workspace.projects-reader": "catalog:codebase",
    "@pnpm/workspace.root-finder": "catalog:codebase",
    "@pnpm/workspace.workspace-manifest-reader": "catalog:codebase",
    "@types/node": "catalog:stack",
    "arkregex": "catalog:stack",
    "tsx": "catalog:stack",
    "typescript": "catalog:stack"
  }
}
